# Configuração da igreja por deploy (Vite). Copie para .env para rodar local
# apontando para outra igreja, ou defina estas variáveis no painel do site
# (ex.: Netlify → Site settings → Environment variables). Um site por igreja.
#
# TODAS são opcionais: sem elas, o app usa a igreja padrão embutida (nuvem.ts).
# Só o site da igreja NOVA precisa definir as três.

# URL do projeto Supabase da igreja (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave publishable (anon) do projeto — feita para ir no navegador
VITE_SUPABASE_ANON_KEY=

# Identificador da igreja dentro do projeto (ex.: "ife-matriz", "nova-igreja").
# É a chave da linha em `estados` e o que separa uma igreja da outra.
VITE_IGREJA_ID=
